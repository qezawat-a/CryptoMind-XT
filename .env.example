XT_API_KEY=your_xt_api_key_here
XT_API_SECRET=your_xt_api_secret_here

# --- LLM Provider (custom base_url for both as requested) ---
# AI_PROVIDER: auto | openai | anthropic
# auto = if ANTHROPIC_API_KEY set and AI_API_KEY empty -> anthropic, else openai-compatible
AI_PROVIDER=auto

# OpenAI-compatible (OpenAI, OpenRouter, Groq, DeepSeek, LiteLLM, etc.)
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL is OPTIONAL. Leave blank -> auto-detect from /models.
# Prefers :free models first, then cheap (mini/flash/nano), then rest.
# On error (402/balance) it auto-switches to next model.
AI_MODEL=
# Optional forced fallback chain: AI_FALLBACK_MODELS=gpt-4o-mini,claude-3-5-haiku
AI_FALLBACK_MODELS=

# Anthropic native (custom base_url as requested)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
# Example for proxy: ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1

# --- Agent ---
AGENT_MAX_STEPS=8
AGENT_AUTONOMOUS_INTERVAL_SEC=15
AGENT_DRY_RUN=false

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
# Local: sqlite | Railway: Neon Postgres (recommended) or MySQL
# Neon example: postgresql://user:pass@ep-xxx-pooler.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///data/memory.db
XT_FUTURES_HOST=https://fapi.xt.com
